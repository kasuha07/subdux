# Subdux environment configuration
#
# Copy this file to .env and replace the secret values before production use.
# Generate a secret with: openssl rand -hex 32

# Stable secrets (recommended in production; use different values).
JWT_SECRET=replace-with-at-least-32-characters
SETTINGS_ENCRYPTION_KEY=replace-with-another-random-secret

# Docker Compose image and published host port.
SUBDUX_VERSION=stable
SUBDUX_HOST_PORT=8080

# Server and storage. Docker Compose fixes PORT=8080 and DATA_PATH=/data inside
# the container; these values apply when running the binary directly.
PORT=8080
DATA_PATH=data
TZ=Asia/Shanghai

# Authentication token lifetimes.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720

# Comma-separated allowed browser origins. Leave empty to use the configured
# site URL, then localhost development origins as a fallback.
CORS_ALLOW_ORIGINS=

# Logging: LOG_LEVEL supports debug, info, warn, or error.
# LOG_FORMAT supports auto, text, or json.
LOG_LEVEL=info
LOG_FORMAT=auto

# Initial administrator settings are used only when the user table is empty.
# Leave the password empty to generate one and print it once during startup.
SUBDUX_INITIAL_ADMIN_USERNAME=admin
SUBDUX_INITIAL_ADMIN_EMAIL=admin@subdux.local
SUBDUX_INITIAL_ADMIN_PASSWORD=
